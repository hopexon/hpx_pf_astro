{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hpx-pf-astro",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "previews": {}
}
