{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hpx-pf-astro",
  "main": "src/workers.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "previews": {},
  "vars": {
    "BASIC_AUTH_REQUIRED": "false"
  },
  "env": {
    // Deploys as the separate Worker "hpx-pf-astro-staging".
    // Select it at build time: CLOUDFLARE_ENV=staging (pnpm build:staging).
    "staging": {
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
        // Static files must pass through the Basic auth check too.
        "run_worker_first": true
      },
      "vars": {
        "BASIC_AUTH_REQUIRED": "true"
      }
    }
  }
}
