---
import Layout from '../../../layouts/Layout.astro'
import { Image } from 'astro:assets'
import './css/mtg.css'
import SubheadLinks from '../../../components/collections/mtg/SubheadLinks'
import { mtgCards } from './data';
---

<Layout>
  <div>
    <h1 class="page__ttl">Test</h1>
    <div class="main__wrap">
      <section class="section__wrapper mtg__section__wrapper">
        <SubheadLinks />
        <div class="grid">
          {mtgCards.map(card => (
            <a class="card__link" href={`/collections/mtg/${card.slug}`}>
              <div class="card__thumb">
                {card.imgFull ? (
                  <img
                    class='card__img'
                    src={`/collections/mtg/${card.imgFull}`} 
                    alt={`${card.name}`} />
                ) : (
                  <img
                    class='card__img'
                    src={`/collections/mtg/${card.imgCard}`} 
                    alt={`${card.name}`} />
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>