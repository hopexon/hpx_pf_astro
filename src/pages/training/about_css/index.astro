---
import Layout from '../../../layouts/Layout.astro'
import { Code } from 'astro:components';

import FontWeight from '../../../components/training/about_css/FontWeight.astro'
import FontSize from '../../../components/training/about_css/FontSize.astro'
import LineHeight from '../../../components/training/about_css/LineHeight.astro'
import ColorHsl from '../../../components/training/about_css/ColorHsl.astro'

import '../style.css'

const animateBlockText = ['F','X','X','K','O','F','F','','B','U','L','L','S','H','I','T','','A','S','S','H','O','L','E',]

const sansSerifParam = [
  { name: "Windows CJK Chromium", ja: "Noto Sans JP<br />※ブラウザ指定のsans-serifフォントに依存", en: "Noto Sans JP<br />※ブラウザ指定のsans-serifフォントに依存" },
  { name: "Windows CJK Firefox", ja: "Meiryo<br />※ブラウザ指定のデフォルトフォントに依存", en: "Meiryo<br />※ブラウザ指定のデフォルトフォントに依存" },
  { name: "Windows EN Chromium", ja: "Noto Sans JP", en: "Arial" },
  { name: "Windows EN Firefox", ja: "Meiryo", en: "Arial" },
  { name: "macOS CJK Chromium", ja: "Hiragino Kakugo ProN", en: "Hiragino Kakugo ProN" },
  { name: "macOS CJK Firefox", ja: "Hiragino Kakugo ProN", en: "Hiragino Kakugo ProN" },
  { name: "macOS CJK Safari", ja: "Hiragino Kakugo", en: "Hiragino Kakugo" },
  { name: "macOS EN Chromium", ja: "Hiragino Kakugo", en: "Helvetica" },
  { name: "macOS EN Firefox", ja: "Hiragino Kakugo ProN", en: "Helvetica" },
  { name: "macOS EN Safari", ja: "Hiragino Kakugo ProN<br>※検証ツール上ではHelvetica", en: "Helvetica" },
  { name: "iOS(systemlang: JA)", ja: "Hiragino Kakugo", en: "Hiragino Kakugo" },
  { name: "iOS(systemlang: EN)", ja: "Hiragino Kakugo ProN", en: "Helvetica" },
  { name: "Android", ja: "Noto Sans CJK JP", en: "Roboto" }
]

const systemUiParam = [
  { name: "Windows Chromium", ja: "Yu Gothic UI", en: "Yu Gothic UI" },
  { name: "Windows Firefox", ja: "Yu Gothic UI", en: "Yu Gothic UI" },
  { name: "macOS Chromium<br>systemlang: JA", ja: "Hiragino Kakugo ProN", en: "San Francisco<br>※検証ツール上では .SF NS" },
  { name: "macOS Chromium<br>systemlang: EN", ja: ".Hiragino Kaku Gothic Interface", en: "San Francisco<br>※同上" },
  { name: "macOS Firefox", ja: "Hiragino Kakugo ProN", en: "San Francisco<br>※同上" },
  { name: "macOS Safari", ja: ".Hiragino Kaku Gothic Interface<br>※検証ツール上では AppleSystemUIFont", en: "San Francisco<br>※同上" },
  { name: "iOS", ja: ".Hiragino Kaku Gothic Interface", en: "San Francisco" },
  { name: "Android", ja: "Noto Sans CJK JP", en: "Roboto" }
]

const popovermenuList = [
  { name: "TOP", path: "/" },
  { name: "Tools", path: "/tools" },
  { name: "Tips", path: "/tips" },
  // { name: "Music Review", path: "https://hpx-pfproject02.vercel.app/music-review/" },
  { name: "Works", path: "/works" },
  { name: "Collections", path: "/collections" },
]
---

<Layout>
  <div>
    <div class="main__wrap">
      <section class="section__wrapper">
        <h1 class='visually__hidden'>Modern Web Development with CSS</h1>
        
        <!-- font size -->
        <FontWeight />

        <!-- font size -->
        <FontSize />

        <!-- line-height -->
        <LineHeight />

        <!-- Color -->
        <ColorHsl />

        <!-- elevation  -->
         <h2 class="mt__8">Elevation</h2>
         <div class="mt__1 comment__wrap">
          <p class="comment">
            <code>filter: drop-shadow()</code>によるエレベーションを用いる場合は、エフェクトの大きさを<code>8段階</code>程度に分類する。<br>
            また高さを持った要素と背景要素の間でコントラスト比を保つ場合は、事前に要素へ持たせた<code>border</code>と背景の間で<code>3:1</code>のコントラスト比を確保する。<br>
            つまり<code>border</code>を持たない要素に高さをもたせてはいけない。<br />
            <br />
            「高さを持った要素」の上に「高さを持った要素」を配置する場合は、原則上側の要素は二段階高く設置すること。
          </p>
         </div>
         <div class="mt__2 elevation__grid">
          {
            Array.from({ length: 8 }).map((_, index) => (
              <div class="elevation__content__wrap">
                <div class={`elevation__shadow__square elevation__shadow__${index + 1}`}></div>
                <p class="elevation__shadow__caption">drop shadow {index + 1}</p>
              </div>
            ))
          }
          <!-- without blur -->
          {
            Array.from({ length: 8 }).map((_, index) => (
              <div class="elevation__content__wrap">
                <div class={`elevation__shadow__square elevation__shadow__${index + 11}`}></div>
                <p class="elevation__shadow__caption">no blur {index + 1}</p>
              </div>
            ))
          }
        </div>
        <div class="mt__8 btns__wrap">
          <button type="button" class='shadow__animate__control btn__item item__hover' id="stop__animation">Shut Up!!</button>
          <button type="button" class='shadow__animate__control btn__item item__hover' id="restart__animation">Just Kidding</button>
        </div>
        <div class="mt__2 shadow__animate__grid">
          {
            Array.from({ length: 24 }).map((_, index) => (
              <div class={`shadow__animate animate__${index+1}`}>
                <div class="shadow__animate__item">{animateBlockText[index % animateBlockText.length]}</div>
              </div>
            ))
          }
        </div>

        <!-- font-family -->
        <h2 class="mt__8">font-famliy<br class="sp__only" /><span style='font-size: 0.6em;'> (for Windows CJK)</span></h2>
        <div class="font__family__grid">
          <div class="mt__2 btns__wrap">
            <button class="btn__item item__hover" data-font-class="default__fontfamily" type="button">Default (Noto Sans JP)</button>
            <button class="btn__item item__hover" data-font-class="udp__fontfamily" type="button">UDP Gothic</button>
            <button class="btn__item item__hover" data-font-class="meiryo__fontfamily" type="button">Meiryo</button>
            <button class="btn__item item__hover" data-font-class="yu__gothic__ui__fontfamily" type="button">Yu Gothic UI</button>
            <button class="btn__item item__hover" data-font-class="yu_gothic__fontfamily" type="button">Yu Gothic</button>
          </div>
          <div class="mt__2 font__family__samples__wrap">
            <p>
              組織はA新しAい技術Aを見てAいます。彼はB丁寧Bにこの問B題をB改善しBていBます。<br>
              あなたはやや過去を学んでいます。チームは実績を見ています。システムは継続的に現在を信じています。これはデータを実施しています。彼らは機会を評価しています。企業はとても実績を見ています。あなたは過去を思っています。誰もが情報を試しています。プロジェクトはわずかにデータを感じています。彼女は目標を提案しています。彼らは新しい技術を期待しています。多くの人々が継続的に情報を知っています。<br />
              Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since 1966, when designers at Letraset and James Mosley, the librarian at St Bride Printing Library in London, took a 1914 Cicero translation and scrambled it to make dummy text for Letraset's Body Type sheets.
            </p>
          </div>
        </div>
        <h4 class="mt__2">▼ Most Stable Font Settings in 2026</h4>
        <Code code={`
    html {
      font-family: 
        "Helvetica Neue",
        "zenkaku-gothic-new",
        "Hiragino Sans",
        Arial,
        "Noto Sans JP", // or BIZ UDPGothic or Meiryo,
        sans-serif;
    }

    or

    html {
      font-family: 
        sans-serif,
        system-ui;
    } 
        `} lang="css" theme="github-dark"></Code>

        <details class="acc__with__anim">
          <summary>Explanation<span class="twister"></span></summary>
          <div class="accordion__overflow__hidden">
            <div class="content__wrap">
              <h4 class="mt__1">▼ sans-serif 対応表</h4>
                <p class="sans__serif">
                  This is a text written with sans-serif.<br />
                  Check the acctual font with devtool.<br />
                  sans-serif を使用したテキストです。<br />
                  検証ツールを用いて実際に用いられているフォントを確認してください。
                </p>

                <!-- graph for sp -->
                <div class="sp__only">
                  {
                    sansSerifParam.map((param) => (
                      <div class="sp__sans__serif__grid">
                        <div class="th sp__name">{param.name}</div>
                        <div class="th sp__ja">JA</div>
                        <div class="td sp__txt__ja" set:html={param.ja} />
                        <div class="th sp__en">EN</div>
                        <div class="td sp__txt__en" set:html={param.en} />
                      </div> 
                    ))
                  }
                </div>

                <!-- graph for pc -->
                <div class="pc__only">
                  <div class="mt__1 sans__serif__grid">
                    <div class="th"></div>
                    <div class="th">和文</div>
                    <div class="th">英文</div>
                    {sansSerifParam.map((param) => (
                      <div class="td">{param.name}</div>
                      <div class="td" set:html={param.ja} />
                      <div class="td" set:html={param.en} />
                    ))}
                  </div>
                </div>

              <h4 class="mt__3">▼ system-ui 対応表</h4>
                <div class="content__wrap">
                  <p class="system__ui">
                    This is a text written with system-ui.<br />
                    Check the acctual font with devtool.<br />
                    system-ui を使用したテキストです。<br />
                    検証ツールを用いて実際に用いられているフォントを確認してください。
                  </p>
                </div>
                <!-- graph for sp -->
                <div class="sp__only">
                  {
                    systemUiParam.map((param) => (
                      <div class="sp__sans__serif__grid">
                        <div class="th sp__name" set:html={param.name} />
                        <div class="th sp__ja">JA</div>
                        <div class="td sp__txt__ja" set:html={param.ja} />
                        <div class="th sp__en">EN</div>
                        <div class="td sp__txt__en" set:html={param.en} />
                      </div>
                    ))
                  }
                </div>

                <!-- graph for pc -->
                <div class="pc__only">
                  <div class="mt__1 sans__serif__grid">
                    <div class="th"></div>
                    <div class="th">和文</div>
                    <div class="th">英文</div>
                    {systemUiParam.map((param) => (
                      <div class="td" set:html={param.name} />
                      <div class="td" set:html={param.ja} />
                      <div class="td" set:html={param.en} />
                    ))}
                  </div>
                </div>

              <h4 class="mt__3">▼sans-serif とは</h4>
                <div class="content__wrap">
                  <p class="comment">
                    その環境が使用可能なデバイスフォント(デフォルトでOSにインストールされているもの)を指定する値。<br />
                    実際にどのフォントが用いられるかはデバイス規定フォントに依存する。
                  </p>
                </div>

              <h4 class="mt__2">▼system-ui とは</h4>
                <div class="content__wrap">
                  <p class="comment">
                    その環境が使用可能なデバイスフォント(デフォルトでOSにインストールされているもの)を指定する値。<br />
                    実際にどのフォントが用いられるかはデバイス規定フォントに依存する。
                  </p>
                </div>

              <h4 class="mt__2">▼sans-serif と system-ui の違い</h4>
                <div class="content__wrap">
                  <p class="comment">
                    上記表の通り、指定されるフォントが異なるのみ。<br />
                    ブラウザによっては<code>sans-serif</code>用の設定項目が個別に設けられている場合がある。
                  </p>
                </div>

              <h4 class="mt__2">▼結局どうすればよいのか</h4>
                <div class="content__wrap">
                  <p class="comment">
                    現状適切なデフォルト値が指定されているため、<code>system-ui</code>または<code>sans-serif</code>の指定で問題ない。<br />
                    が、常にブラウザ自体の挙動に依存する形となるため、意図しない挙動の発生リスクが常に付きまとう。<br />
                    デザインデータが厳密に存在する場合、または段落ちなどレイアウトに気を配る必要のあるページの場合は、やはり引き続き明確にフォントを指定し挙動を管理すべきである。
                  </p>
                </div>
            </div>
          </div>
        </details>

        <!-- accordion -->
        <h2 class="mt__8">Accordion</h2>
        <div class="mt__3 accordion__wrap">
          {
            Array.from({ length: 3 }).map((_, index) => (
              <details name='accordion__sample' class={`accordion__sample__${index + 1}`}>
                <summary>Accordion Sample<span class='twister'></span></summary>
                <div class="accordion__overflow__hidden">
                  <div class="accordion__content">
                    <p class="comment">
                      CSSのみで実装、かつ<code>iOS18.4</code>以降の<code>Safari</code>に対応するアコーディオン。<br />
                      <br />
                      各アコーディオンに<code>name</code>を付与することで、最大展開個数を<code>1</code>とする排他的な実装が可能。<br />
                      <br />
                      <code>iOS18.4</code>から疑似要素<code>::details-content</code>が指定可能となったため、<code>非展開時の ::details-content を grid-template-rows: 0fr</code>に、展開時は<code>1fr</code>に設定のうえ<code>transition-property: grid-template-rows;</code>を指定することでCSSのみの展開アニメーションが可能となる。<br />
                      ただしそのままでは格納時に内容コンテンツがアコーディオンから逸脱してしまうため、コンテンツの<code>div</code>ラップの上にさらに<code>overflow: hidden</code>用の追加<code>div</code>ラップが必要となること、<br />
                      併せて<code>grid-template-columns</code>は相対値プロパティのため、<code>transition-behavior: allow-discrete</code>により相対値プロパティへの<code>transition</code>適用許可が必要となる。
                    </p>
                  </div>
                </div>
              </details>
            ))
          }
        </div>
        <!-- <h3 class="mt__2">Sample Code</h3> -->
        <details class="acc__with__anim">
          <summary>Sample Code<span class="twister"></span></summary>
          <div class="acc__with__anim__hidden">
            <div class='content__wrap'>
<Code code={`
    <details name='accordion__sample' class='accordion__sample__1' open=true>
      <summary>Accordion Sample<span class='twister'></span></summary>
      <div class="accordion__overflow__hidden">
        <div class="accordion__content">
          content...
        </div>
      </div>
    </details>
        `} lang="html" theme="github-dark"></Code>

        <Code code={`
    /* 許可されていない場合は相対値への transition 適用を許可する */
    html {
      transition-behavior: allow-discrete; 
    }

    details {
      &::details-content {
        content-visibility: unset; /* Safari固有不具合への対策 */
        display: block grid;
        line-height: 1.7;
          
        @media(prefers-reduced-motion: no-preference) {
          transition-duration: 300ms;
          transition-property: grid-template-rows;
        }
      }
          
      &:not([open])::details-content {
        grid-template-rows: 0fr;
      }
          
      &[open]::details-content {
        grid-template-rows: 1fr;
      }
    }

    summary {
      display: grid;
      grid-template-columns: 1fr 30px;
      align-items: center;
      padding: 1rem 1.5rem;
      font-size: calc(24 / 16 * 1rem);
      color: var(--paper);
      background-color: var(--blue-400);

      &:not(:last-child) {
        border-bottom: 1px solid var(--paper);
      }
    }

    .accordion__overflow__hidden {
      overflow: hidden;
    }

    .accordion__content {
      padding: 1rem 1.5rem;
      background-color: var(--base-50);
    }
        `} lang="css" theme="github-dark"></Code>
            </div>
          </div>
        </details>

        <!-- modal -->
        <h2 class="mt__8">Modal with<br class="sp__only" /> Dialog Element</h2>
        <div class="mt__2 my__dialog__content__wrap">
          <div class="btns__wrap">
            <button type="button" class="test__dialog__open__btn btn__item item__hover" command="show-modal" commandfor="test-dialog">Open Modal</button>
          </div>
          <div class="my__dialog__wrap">
            <dialog
              id="test-dialog"
              class="my__dialog"
              closedby="any"
              aria-labelledby="dialog-title"
              autofocus
            >
              <h1 id="my-dialog-heading" class="my__dialog__heading">Heading</h1>
              <p class="my__dialog__content">Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since 1966, when designers at Letraset and James Mosley, the librarian at St Bride Printing Library in London, took a 1914 Cicero translation and scrambled it to make dummy text for Letraset's Body Type sheets.</p>
              <button type="button"  class="my__dialog__close__btn" commandfor="test-dialog" command="close">Close</button>
            </dialog>
          </div>
        </div>

        <details class="mt__2 acc__with__anim">
          <summary>Sample Code<span class="twister"></span></summary>
          <div class="accordion__overflow__hidden">
            <div class="content__wrap">
        <Code code={`
    <div class="dialog__open__wrap">
      <button type="button"command="show-modal" commandfor="test-dialog">Open Modal</button>
    </div>

    <dialog
      id="test-dialog"
      class="test__dialog"
      closedby="any"
      aria-labelledby="dialog-title"
      autofocus
    >
      <h1 id="my-dialog-heading">Heading</h1>
      <p>Content</p>
      <button type="button" command="close" commandfor="test-dialog">Close</button>
    </dialog>
        `} lang="html" theme="github-dark"></Code>

        <Code code={`
    :root {
      scrollbar-gutter: stable;
    } 

    // 背面のスクロールを無効化
    :root:has(:modal) {
      overflow: hidden;
    }

    .dialog:not(:modal):not([popover]) {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.95);
    }

    dialog {
      position: fixed; /* Safari固有不具合への対策 */
      inset-block-start: 50%;
      inset-inline-start: 50%;
      margin: 0; /* ユーザエージェントのデフォルト値をリセット */
      max-block-size: 40vh;
      inline-size: min(90vw, calc(600 / 16) * 1rem);
      transform: translate(-50%, -50%);
      transition-duration: 300ms;
      transition-property: display, overlay, opacity, transform; /* overlay はFirefox, Safari27時点で非対応 */
      transition-timing-function: ease-out;
      transition-behavior: allow-discrete;
      overscroll-behavior-block: contain; /* モーダル表示中の縦方向における規定のスクロールオーバーフロー動作を解除する */

      &::backdrop {
        background-color: oklch(from black l c h / 50%);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        transition-duration: inherit;
        transition-property: opacity;
        transition-timing-function: inherit;
      }
    }

    @starting-style {
      dialog:modal {
        opacity: 0;
        transform: translate(-50%, -50%) scale(0.95); /* スケールアニメーションを追加 */
      }
      dialog:modal::backdrop {
        opacity: 0;
      }
    }
        `} lang="css" theme="github-dark"></Code>
            </div>
          </div>
        </details>

        <details class="acc__with__anim">
          <summary>Explanation<span class="twister"></span></summary>
          <div class="accordion__overflow__hidden">
            <div class="content__wrap">
              <h4 class="mt__1">▼dialog attr: command</h4>
                <ul class="comment">
                  <li>・<code>command='show-modal'</code>: モーダルUIの展開</li>
                  <li>・<code>command='close'</code>: モーダルUIを閉じる</li>
                  <li>・<code>command='toggle-popover'</code>: ポップオーバーUIの開閉</li>
                  <li>・<code>command='show-popover'</code>: ポップオーバーUIの展開</li>
                  <li>・<code>command='hide-popover'</code>: ポップオーバーUIを閉じる</li>
                  <li>・<code>command='request-close'</code>: requesttclose() の機能を提供(from chrome 139~)</li>
                </ul>
              <h4 class="mt__1">▼dialog attr: closedby</h4>
                <ul class="comment">
                  <li>・<code>closedby='any'</code>: ダイアログの外側を押下 or ESCでダイアログが閉じる</li>
                  <li>・<code>closedby='closerequest'</code>: ESCでのみダイアログが閉じる</li>
                  <li>・<code>closedby='none'</code>: ESCでもダイアログが閉じない</li>
                  <li>※いずれも <code>command='close'</code> 属性を発火させた場合は閉じる</li>
                </ul>
              <h4 class="mt__1">▼root:has(:modal) と body:has(dialog[open]) の違い</h4>
                <p class="comment">
                  従来支配的であった<code>body:has(dialog[open])</code>は、<code>showModal()</code>と異なる<code>show()</code>メソッドを用いた"背景の操作をブロックしない非モーダル"という表示方法についても背景要素をブロックしてしまう。<br />
                  <code>popover API</code>の登場により上述の方法による非モーダル要素の登場機会は減ったものの、依然として不具合の原因となる可能性は存在する。<br />
                  <br />
                  <code>:modal</code>疑似クラスを用いることで、<code>showModal()</code>メソッドで開かれた<code>dialog</code>要素のような「ユーザがその操作をしている間ほかのすべての要素との操作をブロックする状態にある要素」のみを選択可能となる。<br />
                  <br />
                  <code>:modal</code> 疑似クラスは動画など特定の要素を<code>requestFullscreen()</code> APIを用いてフルスクリーンを表示する際にも適用されるため、 <code>:root:has(:modal)</code> はフルスクリーン表示時にも併せて対応可能となる。<br />
                  <br />
                  なおスクロールを制御するCSSとしては<code>overflow: clip</code>も存在する。<br />
                  基本的には意図しないスクロールコンテナやスタッキングコンテキストの出現を防げるため<code>overflow: clip</code>が優先されるが、現状<code>Firefox</code>にてルート要素に対する<code>overflow: clip</code>を用いたスクロール抑制が機能していないため、同目的には<code>hidden</code>が推奨される。
                </p>
              <h4 class="mt__1">▼なぜ :root に overflow: hidden を設定するか</h4>
                <p class="comment">
                  <code>position: sticky</code>との兼ね合いにより、<code>body</code>への<code>overflow: hidden</code>指定は推奨されない。<br />
                  <code>sticky</code> は「最も近い親のスクロールコンテナを基準に固定される」仕組みのため、<code>body</code>要素に<code>overflow: hidden</code> を設定することで同要素が新たなスクロールコンテナとなり、本来<code>:root</code>(または<code>html</code>)に紐づいていたはずの<code>sticky</code>が<code>body</code>基準に移行してしまい、不具合が発生する。<br />
                  一方CSSの仕様として「ルート要素に付与された<code>overflow</code>プロパティはそのままブラウザの表示領域全体(いわゆるビューポート)に転送される」ため、<code>:root</code>への指定では新たなスクロールコンテナは生成されず、不具合には発展しない。
                </p>
            </div>
          </div>
        </details>

