---
import Layout from '../../layouts/Layout.astro'
import PageHeader from '../../components/common/PageHeader.astro'
import PanelSection from '../../components/common/PanelSection.astro'
import ContactForm from '../../components/contact/ContactForm.astro'
---

<Layout title="Contact" description="HPXへのお仕事のご相談、ご感想、お問い合わせはこちらから。">
  <PageHeader
    eyebrow="Contact"
    title="Contact"
    lead="お仕事のご相談、恨みつらみ、短歌など<br />お気軽にご連絡ください"
  />
  <div class="section__wrapper">
    <PanelSection class="contact-panel" title="Contact Form" titleId="contact-title" aria-labelledby="contact-title">
      <div class="contact">
        <ContactForm />
      </div>
    </PanelSection>
  </div>
</Layout>

<style>
  .contact {
    max-inline-size: 40rem;
  }
</style>
