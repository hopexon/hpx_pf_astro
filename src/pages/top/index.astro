---
import Layout from "../../layouts/Layout.astro";
import IndexMenu from "../../components/common/IndexMenu.astro";
import { groupWorks, workAnchorId } from "../../lib/works";

const menuList = [
  { name: "About", path: "/about", description: "どちら様ですか" },
  { name: "Works", path: "/works", description: "Digital Drawing - Flyer Design" },
  { name: "Tools", path: "/tools", description: "Utility Tools for Web Devs and Designs" },
  { name: "Tips", path: "/tips", description: "Tips for Web Devs and Designs" },
  // { name: "Music Review", path: "https://hpx-pfproject02.vercel.app/music-review/" },
  { name: "Contact", path: "/contact", description: "お仕事のご相談、恨みつらみ、短歌など" },
];

// data.ts の並び順で先頭の作品から、各1枚ずつ抜粋する
const recentWorks = groupWorks()
  .slice(0, 4)
  .map(({ title, date, images }, index) => ({
    title,
    date,
    image: images[0],
    href: `/works#${workAnchorId(index)}`,
  }));
---

<Layout title="TOP">
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__copy">
        <p class="page__eyebrow">Web Platform</p>
        <!-- <h1 class="hero__ttl">Kiyotaka<br />Dekke</h1> -->
        <h1 class="hero__ttl">HPX</h1>
        <p class="hero__role">
          <span class="role__1">Markup Engineer /</span><br />
          <span class="role__2">Digital Drawing / Flyer Design /</span><br />
          <span class="role__3">Passionate Writing /</span><br />
          <span class="role__4">Horribly beautiful voice /</span><br />
          <span class="role__5">Other odds and ends</span>
        </p>
        <!-- <p class="hero__lead">
          A Frontend engineer specializing in MARK-UP.<br />
          Also offer hand-drawn flyer and poster design.
        </p> -->
      </div>
      <img
        class="hero__logo"
        src="/hpx_logo_header.svg"
        alt=""
        width="640"
        height="640"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section__wrapper" aria-labelledby="top-index">
    <h2 class="top__label" id="top-index">Index</h2>
    <IndexMenu menuList={menuList} />
  </section>

  <section class="section__wrapper recent" aria-labelledby="top-recent">
    <div class="recent__head">
      <h2 class="top__label" id="top-recent">Selected Works</h2>
      <a href="/works" class="recent__more link__twister">All Works</a>
    </div>
    <ul class="recent__list">
      {
        recentWorks.map(({ title, date, image, href }) => (
          <li class="recent__item reveal">
            <a href={href} class="recent__link">
              <img
                src={`/works/${image.imgBaseName}_A2.avif`}
                alt={image.alt || title}
                width={Number(image.width)}
                height={Number(image.height)}
                loading="lazy"
                decoding="async"
              />
              {/* data.ts では無題の作品を '-' としている */}
              <span class="recent__ttl" set:html={title === '-' ? 'Untitled' : title} />
              <span class="recent__date">{date}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  /* ---------------------------
  Hero
  --------------------------- */
  .hero {
    overflow: clip;
    font-family: var(--font-sans);
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
    padding: 1.5rem var(--page-gutter) 3rem;
    margin-inline: auto;
    max-inline-size: var(--inline-content-size);

    /* PC ではロゴ（上下中央に absolute 配置）とコピーの縦位置を揃える */
    @media screen and (min-width: 900px) {
      align-items: center;
      padding-block: clamp(4rem, 2rem + 6vw, 7.5rem) clamp(3rem, 2rem + 4vw, 6rem);
      min-block-size: min(calc(100svh - var(--header-block-size)), 46rem);
    }
  }

  .hero__copy {
    position: relative;
    z-index: 1;
  }

  .hero__ttl {
    margin: 0;
    font-size: clamp(3.25rem, 1.4rem + 9.5vw, 9.5rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .hero__role {
    margin-block-start: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    font-size: clamp(0.8125rem, 0.75rem + 0.3vw, 1rem);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;

    .role__2 { color: var(--base-700); }
    .role__3 { color: var(--base-600); }
    .role__4 { color: var(--base-500); }
    .role__5 { color: var(--base-400); }
  }

  .hero__lead {
    margin-block-start: 1rem;
    max-inline-size: 34em;
    font-size: clamp(0.9375rem, 0.9rem + 0.25vw, 1.0625rem);
    line-height: var(--leading-body);
    color: var(--base-700);
  }

  /* ロゴは右側で大きく見切れさせ、ゆっくり回す。
    SP では文字と重ならないようコピーの上に置き、PC では右側に重ねる */
  .hero__logo {
    order: -1;
    justify-self: end;
    margin-block-end: 1.5rem;
    margin-inline-end: -24vw;
    inline-size: min(84vw, 26rem);
    block-size: auto;

    @media screen and (min-width: 900px) {
      position: absolute;
      inset-block-start: 50%;
      inset-inline-end: -2vw;
      margin: 0;
      inline-size: clamp(26rem, 46vw, 44rem);
      translate: 0 -50%;
    }

    @media (prefers-reduced-motion: no-preference) {
      animation: hero-spin 180s linear infinite;
    }
  }

  @keyframes hero-spin {
    to {
      rotate: 360deg;
    }
  }

  /* ---------------------------
  Index / Recent Works
  --------------------------- */
  .top__label {
    display: flex;
    align-items: center;
    column-gap: 0.75rem;
    margin-block-end: 1.25rem;
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .top__label::before {
    content: '';
    inline-size: 2rem;
    border-block-start: 2px solid var(--color-accent);
  }

  .recent {
    font-family: var(--font-sans);
  }

  .recent__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    column-gap: 1rem;
    padding-block-end: 1.25rem;
    margin-block-end: 2rem;
    border-block-end: 1px solid var(--color-rule-strong);
  }

  .recent__head .top__label {
    margin-block-end: 0;
  }

  .recent__head .recent__more {
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .recent__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.25rem;
    padding: 0;
    margin: 0;
    list-style: none;

    @media screen and (min-width: 768px) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: clamp(1.25rem, 2.5vw, 2.5rem);
    }
  }

  .recent__link {
    display: grid;
    row-gap: 0.25rem;
  }

  .recent__link img {
    margin-block-end: 0.75rem;
    inline-size: 100%;
    block-size: auto;
    box-shadow:
      0 0 0 1px rgb(16 15 15 / 0.08),
      0 1.25rem 2rem -1.25rem rgb(16 15 15 / 0.4);
    transition: translate 0.45s var(--ease-out);
  }

  .recent__ttl {
    font-weight: 700;
    line-height: 1.4;
  }

  .recent__date {
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }

  @media (any-hover: hover) {
    .recent__link:hover img {
      translate: 0 -0.5rem;
    }
  }
</style>
