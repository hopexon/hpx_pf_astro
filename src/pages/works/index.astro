---
import Layout from '../../layouts/Layout.astro'
import WorksList from '../../components/works/WorksList.astro'
import { works } from './data'
import './style.css'
---

<Layout title="Works" description="HPX's Drawing Collections.">
  <h1 class="page__ttl">Works</h1>
  <section class="section__wrapper">
    {works.map((work, index) => <WorksList {...work} index={index} />)}
  </section>
</Layout>
