---
import Layout from '../../layouts/Layout.astro'
import PageHeader from '../../components/common/PageHeader.astro'
import WorksList from '../../components/works/WorksList.astro'
import WorksLightbox from '../../components/works/WorksLightbox.astro'
import { groupWorks } from '../../lib/works'
import './style.css'

const workGroups = groupWorks()
---

<Layout title="Works" description="HPX's Drawing Collections.">
  <PageHeader
    eyebrow="Works"
    title="Works"
    lead="手描きでのフライヤー、ポスターデザイン。"
  />
  <section class="section__wrapper">
    {
      workGroups.map((work, index) => (
        <WorksList {...work} index={index} total={workGroups.length} />
      ))
    }
  </section>
  <WorksLightbox />
</Layout>
