---
import Layout from '../../layouts/Layout.astro'

import {
  FontWeight,
  FontSize,
  LineHeight,
  ColorHsl,
  Elevation,
  FontFamily,
  AccordionSample,
  ModalSample,
  PopoverSample,
  WhereIsHasNot,
  // RoundModRem,
  MwgHtml,
  MwgCss,
  Images
} from '../../components/tips'

import './style.css'
const topics = [
  { id: 'font-weight', label: 'font-weight', component: FontWeight },
  { id: 'font-size', label: 'font-size', component: FontSize },
  { id: 'line-height', label: 'line-height', component: LineHeight },
  { id: 'color-functions', label: 'Color Functions', component: ColorHsl },
  { id: 'images', label: 'Images', component: Images },
  { id: 'elevation', label: 'Elevation', component: Elevation },
  { id: 'font-family', label: 'font-family', component: FontFamily },
  { id: 'accordion', label: 'Accordion', component: AccordionSample },
  { id: 'modal', label: 'Dialog', component: ModalSample },
  { id: 'popover', label: 'Popover', component: PopoverSample },
  { id: 'selectors', label: 'CSS Selectors', component: WhereIsHasNot },
  { id: 'html-guide', label: 'HTML Guide', component: MwgHtml },
  { id: 'css-guide', label: 'CSS Guide', component: MwgCss },
]
---

<Layout title="Tips | Modern Web Development">
  <div>
    <h1 class="page__ttl">Web Development Tips</h1>
    <div class="main__wrap">
      <div class="section__wrapper">
        <header class="tips__intro">
          <details class="tips__contents">
            <summary>Contents<span aria-hidden="true">＋</span></summary>
            <div class="accordion__overflow__hidden">
              <nav aria-label="Tipsの目次">
                <ol>
                  {topics.map(({ id, label }, index) => (
                    <li><a href={`#${id}`}>{label}</a></li>
                  ))}
                </ol>
              </nav>
            </div>
          </details>
        </header>
        {topics.map(({ id, component: Component }) => (
          <section id={id} class="tips__topic"><Component /></section>
        ))}
      </div>
    </div>
  </div>
</Layout>