---
import { workAnchorId } from '../../lib/works'

interface WorkImage {
  imgBaseName: string
  alt: string
  width: number | string
  height: number | string
}

interface Props {
  title: string
  venue: string
  date: string
  /** 同じ作品に属する画像 (1枚以上) */
  images: WorkImage[]
  index: number
  total: number
}

const { title, venue, date, images, index, total } = Astro.props

const pad = (value: number) => String(value).padStart(2, '0')
// data.ts では無題の作品を '-' としている
const isUntitled = title === '-' || title === ''
const isFirst = index === 0
const isMulti = images.length > 1
// alt / キャプション用のプレーンテキスト (title は HTML を含むことがある)
const displayTitle = isUntitled ? 'Untitled' : title.replace(/<[^>]*>/g, '')
---

<article id={workAnchorId(index)} class:list={['artwork', { reveal: !isFirst }]}>
  <header class="artwork__info">
    <p class="artwork__num" aria-hidden="true">{pad(index + 1)}<span> / {pad(total)}</span></p>
    <h2 class:list={['artwork__ttl', { 'artwork__ttl--untitled': isUntitled }]}>
      {isUntitled ? 'Untitled' : <Fragment set:html={title} />}
    </h2>
    <dl class="artwork__meta">
      {date !== '' && (
        <div>
          <dt>Date</dt>
          <dd class="artwork__date">{date}</dd>
        </div>
      )}
      {venue !== '' && (
        <div>
          <dt>Venue</dt>
          <dd class="artwork__venue">{venue}</dd>
        </div>
      )}
    </dl>
  </header>

  <div class:list={['artwork__media', { 'artwork__media--multi': isMulti }]}>
    {
      images.map((image, imageIndex) => {
        const src = `/works/${image.imgBaseName}_A2.avif`
        const alt = image.alt || displayTitle
        // PC ではすべての画像をクリックで拡大できる (SP では JS 側で disabled)
        return (
          <button
            type="button"
            class="artwork__zoom"
            data-zoom-src={src}
            data-zoom-alt={alt}
            data-zoom-width={image.width}
            data-zoom-height={image.height}
            data-zoom-caption={displayTitle}
            aria-haspopup="dialog"
            aria-label={`${alt} を拡大表示`}
            disabled
          >
            <img
              src={src}
              alt={alt}
              width={Number(image.width)}
              height={Number(image.height)}
              class="artwork__img"
              style={`--img-ratio: ${Number(image.width) / Number(image.height)}`}
              loading={isFirst ? 'eager' : 'lazy'}
              fetchpriority={isFirst && imageIndex === 0 ? 'high' : 'auto'}
              decoding="async"
            />
          </button>
        )
      })
    }
  </div>
</article>
