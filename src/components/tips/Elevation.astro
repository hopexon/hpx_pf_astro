---
const animateBlockText = [
  "F",
  "X",
  "X",
  "K",
  "O",
  "F",
  "F",
  "",
  "B",
  "U",
  "L",
  "L",
  "S",
  "H",
  "I",
  "T",
  "",
  "A",
  "S",
  "S",
  "H",
  "O",
  "L",
  "E",
];
---

<tips-elevation>
  <h2 class="mt__8">Elevation</h2>
  <div class="mt__1 comment__wrap">
    <p class="comment">
      <code>filter: drop-shadow()</code
      >によるエレベーションを用いる場合は、エフェクトの大きさを<code>8段階</code
      >程度に分類する。<br />
      また高さを持った要素と背景要素の間でコントラスト比を保つ場合は、事前に要素へ持たせた<code
        >border</code
      >と背景の間で<code>3:1</code>のコントラスト比を確保する。<br />
      つまり<code>border</code>を持たない要素に高さをもたせてはいけない。<br />
      <br />
      「高さを持った要素」の上に「高さを持った要素」を配置する場合は、原則上側の要素は二段階高く設置すること。
    </p>
  </div>
  <div class="mt__2 elevation__grid">
    {
      Array.from({ length: 8 }).map((_, index) => (
        <div class="elevation__content__wrap">
          <div
            class={`elevation__shadow__square elevation__shadow__${index + 1}`}
          />
          <p class="elevation__shadow__caption">drop shadow {index + 1}</p>
        </div>
      ))
    }
    <!-- without blur -->
    {
      Array.from({ length: 8 }).map((_, index) => (
        <div class="elevation__content__wrap">
          <div
            class={`elevation__shadow__square elevation__shadow__${index + 11}`}
          />
          <p class="elevation__shadow__caption">no blur {index + 1}</p>
        </div>
      ))
    }
  </div>
  <div class="mt__8 btns__wrap">
    <button
      type="button"
      class="shadow__animate__control btn__item item__hover"
      id="stop__animation">Shut Up!!</button
    >
    <button
      type="button"
      class="shadow__animate__control btn__item item__hover"
      id="restart__animation">Just Kidding</button
    >
  </div>
  <div class="mt__2 shadow__animate__grid">
    {
      Array.from({ length: 24 }).map((_, index) => (
        <div class={`shadow__animate animate__${index + 1}`}>
          <div class="shadow__animate__item">
            {animateBlockText[index % animateBlockText.length]}
          </div>
        </div>
      ))
    }
  </div>
</tips-elevation>

<script>
  class TipsElevation extends HTMLElement {
    private isRunning = true;
    private shouldChangeText = false;
    private timerId: number | null = null;
    private items: HTMLElement[] = [];

    connectedCallback() {
      this.items = [...this.querySelectorAll<HTMLElement>(".shadow__animate")];
      const stopButton = this.querySelector("#stop__animation");
      const restartButton = this.querySelector("#restart__animation");

      stopButton?.addEventListener("click", () => {
        this.isRunning = false;
        this.clearTimer();

        this.items.forEach((item) => {
          const target = item.querySelector(".shadow__animate__item");

          item.classList.remove("is-animating");

          if (target) {
            target.classList.remove("is-active");
            target.textContent = "!!";
          }
        });
      });

      restartButton?.addEventListener("click", () => {
        if (this.isRunning) return;

        this.isRunning = true;
        this.shouldChangeText = true;
        this.animateRandomItem();
      });

      this.isRunning = true;
      this.animateRandomItem();
    }

    // DOM から外れたら(別ページへ遷移したら)アニメーションのループを止める
    disconnectedCallback() {
      this.isRunning = false;
      this.clearTimer();
    }

    private clearTimer() {
      if (this.timerId !== null) {
        clearTimeout(this.timerId);
        this.timerId = null;
      }
    }

    private animateItem(item: HTMLElement) {
      if (!this.isRunning || item.classList.contains("is-animating")) return;

      const target = item.querySelector(".shadow__animate__item");
      if (!target) return;

      item.classList.add("is-animating");
      target.classList.add("is-active");

      if (this.shouldChangeText) {
        const textVal = Math.random();
        if (textVal < 0.33) {
          target.textContent = "HE!";
        } else if (textVal > 0.66) {
          target.textContent = "HO!";
        } else {
          target.textContent = "HA!";
        }
      }

      window.setTimeout(() => {
        target.classList.remove("is-active");
        item.classList.remove("is-animating");
      }, 150);
    }

    private animateRandomItem() {
      if (!this.isRunning || this.items.length === 0) return;

      const item = this.items[Math.floor(Math.random() * this.items.length)];
      this.animateItem(item);

      const delay = Math.floor(Math.random()) + 5;
      this.timerId = window.setTimeout(() => this.animateRandomItem(), delay);
    }
  }

  customElements.define("tips-elevation", TipsElevation);
</script>

<style>
  tips-elevation {
    display: contents;
  }
</style>
