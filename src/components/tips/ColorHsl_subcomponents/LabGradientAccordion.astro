<details class="acc__with__anim">
  <summary>Lab with Gradient<span class="twister"></span></summary>
  <div class="accordion__overflow__hidden">
    <div class="content__wrap">
      <div class="mt__2 lab-grad-controls-1">
        <div class="lab-grad-control">
          <label for="lab__grad__l">Lightness:</label>
          <input type="range" id="lab__grad__l" min="0" max="100" value="100" step="0.0001">
        </div>
        <div class="lab-grad-control">
          <label for="lab__grad__a">a:</label>
          <input type="range" id="lab__grad__a" min="-125" max="125" value="0" step="0.0001">
        </div>
        <div class="lab-grad-control">
          <label for="lab__grad__b">b:</label>
          <input type="range" id="lab__grad__b" min="-125" max="125" value="0" step="0.0001">
        </div>
        <div class="lab-grad-control">
          <label for="lab__grad__al">Alpha:</label>
          <input type="range" id="lab__grad__al" min="0" max="1" value="1" step="0.01">
        </div>
      </div>
      <div class="mt__2 lab-grad-controls-2">
        <div class="lab-grad-control">
          <label for="lab__grad__l__2">Lightness:</label>
          <input type="range" id="lab__grad__l__2" min="0" max="100" value="0" step="0.0001">
        </div>
        <div class="lab-grad-control">
          <label for="lab__grad__a__2">a:</label>
          <input type="range" id="lab__grad__a__2" min="-125" max="125" value="0" step="0.0001">
        </div>
        <div class="lab-grad-control">
          <label for="lab__grad__b__2">b:</label>
          <input type="range" id="lab__grad__b__2" min="-125" max="125" value="0" step="0.0001">
        </div>
        <div class="lab-grad-control">
          <label for="lab__grad__al__2">Alpha:</label>
          <input type="range" id="lab__grad__al__2" min="0" max="1" value="1" step="0.01">
        </div>
      </div>
      <div class="mt__2 lab-grad-value color__value__txt">
        <p>background-color: <span class="lab-grad-value__text"></span></p>
      </div>
      <div class="color-function-preview lab-grad-preview"></div>
      <div class="mt__8 lab-grad-random-preview"></div>
    </div>
  </div>
</details>

<!-- Lab with Gradation Random-->
<script>
  document.addEventListener('astro:page-load', function() {
    const labGRandomPreviewBox = document.querySelector('.lab-grad-random-preview') as HTMLDivElement
    const transitionDuration = 2000

    type LabColor = [number, number, number]

    const randomLabColor = (): LabColor => [
      Math.random() * 100,
      Math.random() * 250 - 125,
      Math.random() * 250 - 125,
    ]

    const interpolateLabColor = (from: LabColor, to: LabColor, progress: number): LabColor => [
      from[0] + (to[0] - from[0]) * progress,
      from[1] + (to[1] - from[1]) * progress,
      from[2] + (to[2] - from[2]) * progress,
    ]

    let startColor1 = randomLabColor()
    let targetColor1 = randomLabColor()
    let startColor2 = randomLabColor()
    let targetColor2 = randomLabColor()
    let transitionStart = 0

    const updateLabGRandomPreview = (timestamp: number) => {
      if (transitionStart === 0) transitionStart = timestamp

      const progress = Math.min((timestamp - transitionStart) / transitionDuration, 1)
      const color1 = interpolateLabColor(startColor1, targetColor1, progress)
      const color2 = interpolateLabColor(startColor2, targetColor2, progress)

      labGRandomPreviewBox.style.backgroundImage = `linear-gradient(to right, lab(${color1.join(' ')}), lab(${color2.join(' ')}))`

      if (progress === 1) {
        startColor1 = targetColor1
        targetColor1 = randomLabColor()
        startColor2 = targetColor2
        targetColor2 = randomLabColor()
        transitionStart = timestamp
      }

      window.requestAnimationFrame(updateLabGRandomPreview)
    }

    window.requestAnimationFrame(updateLabGRandomPreview)
  })
</script>

<!-- Lab with Gradation-->
<script>
  document.addEventListener('astro:page-load', function() {
    const labGLInput1 = document.getElementById('lab__grad__l') as HTMLInputElement
    const labGAInput1 = document.getElementById('lab__grad__a') as HTMLInputElement
    const labGBInput1 = document.getElementById('lab__grad__b') as HTMLInputElement
    const labGAlInput1 = document.getElementById('lab__grad__al') as HTMLInputElement
    const labGLInput2 = document.getElementById('lab__grad__l__2') as HTMLInputElement
    const labGAInput2 = document.getElementById('lab__grad__a__2') as HTMLInputElement
    const labGBInput2 = document.getElementById('lab__grad__b__2') as HTMLInputElement
    const labGAlInput2 = document.getElementById('lab__grad__al__2') as HTMLInputElement
    const labGPreviewBox = document.querySelector('.lab-grad-preview') as HTMLDivElement

    const updateLabGPreview = () => {
      const l1 = labGLInput1.value
      const a1 = labGAInput1.value
      const b1 = labGBInput1.value
      const al1 = labGAlInput1.value
      const l2 = labGLInput2.value
      const a2 = labGAInput2.value
      const b2 = labGBInput2.value
      const al2 = labGAlInput2.value

      labGPreviewBox.style.backgroundImage = `linear-gradient(to right, lab(${l1} ${a1} ${b1} / ${al1}), lab(${l2} ${a2} ${b2} / ${al2}))`
    }

    labGLInput1.addEventListener('input', updateLabGPreview)
    labGAInput1.addEventListener('input', updateLabGPreview)
    labGBInput1.addEventListener('input', updateLabGPreview)
    labGAlInput1.addEventListener('input', updateLabGPreview)
    labGLInput2.addEventListener('input', updateLabGPreview)
    labGAInput2.addEventListener('input', updateLabGPreview)
    labGBInput2.addEventListener('input', updateLabGPreview)
    labGAlInput2.addEventListener('input', updateLabGPreview)

    updateLabGPreview()
  })
</script>