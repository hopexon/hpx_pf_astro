      <source
        media="(max-width: 767px)"
        type="image/avif"
        srcset="img_01_sp.avif 300w, img_01_sp@2x.avif 600w, img_01_sp@3x.avif 900w"
        sizes="100dvw"
        width="300"
        height="400"
