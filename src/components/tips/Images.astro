        type="image/avif"
        srcset="img_01_tb.avif 1000w, img_01_tb@2x.avif 2000w, img_01_tb@3x.avif 3000w"
        sizes="100dvw"
        width="1000"
        height="1000"
      >
      <source
        type="image/avif"
        srcset="img_01.avif 1200w, img_01@2x.avif 2400w, img_01@3x.avif 3600w"
        sizes="1200px"
        width="1200"
        height="900"
