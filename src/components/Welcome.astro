---
import logoSvg from '../../public/hpx_logo.svg?raw'

const driftSlots = Array.from({ length: 23 }, (_, index) => index)
for (let index = driftSlots.length - 1; index > 0; index--) {
  const other = Math.floor(Math.random() * (index + 1))
  ;[driftSlots[index], driftSlots[other]] = [driftSlots[other], driftSlots[index]]
}
let driftIndex = 0

const cutLines = logoSvg.match(/<g fill="none" stroke="#fff" stroke-width="8">[\s\S]*?<\/g>/)?.[0] ?? ''
const animatedLogoSvg = logoSvg
  .replace(cutLines, '')
  .replace(/<rect width="1600" height="1600" fill="#fff" \/>/, '')
  .replace(
  /<path class="sector" data-angle="(\d+)" style="([^"]+)" fill="([^"]+)" d="([^"]+)" \/>/g,
  (_, angle: string, style: string, fill: string, path: string) => {
    const radians = (Number(angle) + 7.5 - 90) * Math.PI / 180
    const distanceFactor = 0.8 + Math.random() * 0.4
    const duration = 4.6
    const delay = driftSlots[driftIndex++] * 0.2 + Math.random() * 0.04 - duration
    const clipId = `moving-sector-${angle}`
    const motionStyle = [
      `--drift-x: ${(Math.cos(radians) * distanceFactor).toFixed(5)}`,
      `--drift-y: ${(Math.sin(radians) * distanceFactor).toFixed(5)}`,
      `--drift-duration: ${duration.toFixed(3)}s`,
      `--drift-delay: ${delay.toFixed(3)}s`,
    ].join('; ')

    return `<g class="sector" data-angle="${angle}" fill="${fill}" style="${style}; ${motionStyle}">
      <defs><clipPath id="${clipId}"><path d="${path}" /></clipPath></defs>
      <path d="${path}" />
      <g clip-path="url(#${clipId})">${cutLines}</g>
    </g>`
  },
)
---

<div class="animated">
  <p class="caption caption--brand">HPX</p>
  <p class="caption caption--kind">Web Platform</p>
  <div class="stage">
    <div class="logo" set:html={animatedLogoSvg} />
    <a class="enter" href="/top/">Enter</a>
  </div>
  <p class="caption caption--name">Kiyotaka Dekke</p>
  <p class="caption caption--place">Sapporo, Japan</p>
</div>

<style>
  .animated {
    --logo-padding: calc(52 / 16 * 1rem);

    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    min-block-size: 100dvh;
    /* 外側へ移動した三角形の分はスクロールさせず、画面端で切り落とす。 */
    overflow: clip;

    .stage {
      position: relative;
      /* 幅・高さの小さい方に合わせ、スクロールなしで全体を表示する。 */
      inline-size: min(100%, 100dvh, 1000px);
    }

    .enter {
      position: absolute;
      /* ボタンの中心をロゴの中心に重ねる。 */
      inset-block-start: 50%;
      inset-inline-start: 50%;
      display: inline-flex;
      align-items: center;
      column-gap: 1rem;
      padding: 0.875rem 1.75rem;
      inline-size: max-content;
      font-size: 0.875rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--color-ink);
      background-color: var(--color-accent);
      translate: -50% -50%;
      transition:
        color 0.2s ease-out,
        background-color 0.2s ease-out;
      z-index: 1;

      @media (any-hover: hover) {
        &:hover {
          color: var(--color-bg);
          background-color: var(--color-ink);
        }

        &:hover::after {
          rotate: 180deg;
        }
      }

      @media screen and (min-width: 1000px) {
        padding: 1rem 2.5rem;
      }
    }
  }

  /* 四隅の小さなキャプション */
  .caption {
    --inset: clamp(1rem, 3vw, 2rem);

    position: absolute;
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    z-index: 1;
  }

  .caption--brand {
    inset-block-start: var(--inset);
    inset-inline-start: var(--inset);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .caption--kind {
    inset-block-start: var(--inset);
    inset-inline-end: var(--inset);
  }

  .caption--name {
    inset-block-end: var(--inset);
    inset-inline-start: var(--inset);
  }

  .caption--place {
    inset-block-end: var(--inset);
    inset-inline-end: var(--inset);
  }

  .logo,
  .logo :global(svg) {
    display: block;
    inline-size: 100%;
  }

  .logo {
    box-sizing: border-box;
    padding: var(--logo-padding);
  }

  .logo :global(svg) {
    /*
     * SVG内のpxはviewBoxの座標(直径1600)なので、図の直径に比例して拡縮する。
     * 比率は直径896pxのときに160px飛び出す大きさ。
     */
    --drift-distance: calc(1600px * 160 / 896);

    overflow: visible;
  }

  .animated {
    /* 空いている区画を飛ばし、23個で一周する。 */
    --cycle-duration: 1.25s;
    --sector-count: 23;
    --step-duration: calc(var(--cycle-duration) / var(--sector-count));
  }

  .animated :global(.sector) {
    translate: 0 0;
    animation:
      light-sector var(--cycle-duration) steps(1, end) infinite,
      drift-sector var(--drift-duration) cubic-bezier(0.16, 1, 0.3, 1) infinite;
    /* 負の遅延で初回から7区画を点灯させ、一周の境目でも連続させる。 */
    animation-delay:
      calc((var(--sector-index) - var(--sector-count)) * var(--step-duration)),
      var(--drift-delay);
  }

  /* 4.6秒周期のうち、0.15秒で飛び出し、0.85秒まで保持、1秒で戻る。 */
  @keyframes drift-sector {
    0%, 21.73913%, 100% {
      translate: 0 0;
    }
    3.26087%, 18.478261% {
      translate:
        calc(var(--drift-x) * var(--drift-distance, 40px))
        calc(var(--drift-y) * var(--drift-distance, 40px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animated :global(.sector) {
      animation: none;
    }
  }
</style>