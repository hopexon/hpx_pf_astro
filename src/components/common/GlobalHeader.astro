---
const NAV = [
  { name: 'TOP', path: '/' },
  { name: 'About', path: '/about' },
  { name: 'Tools', path: '/tools' },
  { name: 'Tips', path: '/tips' },
  { name: 'Works', path: '/works' },
  { name: 'Collections', path: '/collections' }
]
---

<header class='globalheader'>
  <nav class='global__nav__pc pc__only'>
    {
      NAV.map((item) => (
        <a
          href={item.path}
          class='nav__linkItem link__twister'
        >
          {item.name}
        </a>
      ))
    }
  </nav>

  <button
    type='button'
    command='show-modal'
    commandfor='nav__sp'
    class='nav__btn__sp sp__only'
    aria-label='メニュー'>
  </button>

  <dialog
    id='nav__sp'
    closedby='any'
    aria-label='メニュー'
  >
    <nav class='nav__sp__linkitem__wrap'>
      {
        NAV.map((item) => (
          <a
            href={item.path}
            class='linkitem__link link__twister'
          >
            {item.name}
          </a>
        ))
      }
    </nav>
    <button
      type='button'
      command='close'
      commandfor='nav__sp'
      class='nav__close__sp'
      aria-label='メニューを閉じる'>
    </button>
  </dialog>
</header>

<script>
  import 'invokers-polyfill';
  import 'dialog-closedby-polyfill';
</script>
