---
const NAV = [
  { name: 'TOP', path: '/top' },
  { name: 'About', path: '/about' },
  { name: 'Works', path: '/works' },
  { name: 'Tools', path: '/tools' },
  { name: 'Tips', path: '/tips' },
  // { name: 'Collections', path: '/collections' }
]
---

<header class='globalheader'>
  <nav class='global__nav__pc pc__only'>
    {
      NAV.map((item) => (
        <a
          href={item.path}
          class='nav__linkItem link__twister'
        >
          {item.name}
        </a>
      ))
    }
  </nav>

  <a
    href='/'
    class='global__logo pc__only'
    aria-label='トップへ戻る'>
    <img
      src='/hpx_logo_header.svg'
      alt=''
      width='32'
      height='32'
    />
  </a>

  <button
    type='button'
    command='show-modal'
    commandfor='nav__sp'
    class='nav__btn__sp sp__only'
    aria-label='メニュー'>
  </button>

  <nav-dialog>
  <dialog
    id='nav__sp'
    closedby='any'
    aria-label='メニュー'
  >
    <nav class='nav__sp__linkitem__wrap'>
      {
        NAV.map((item) => (
          <a
            href={item.path}
            class='linkitem__link link__twister'
          >
            {item.name}
          </a>
        ))
      }
    </nav>
    <a
      href='/'
      class='nav__logo__sp'
      aria-label='トップへ戻る'>
      <img
        src='/hpx_logo_header.svg'
        alt=''
        width='40'
        height='40'
      />
    </a>
    <button
      type='button'
      command='close'
      commandfor='nav__sp'
      class='nav__close__sp'
      aria-label='メニューを閉じる'>
    </button>
  </dialog>
  </nav-dialog>
</header>

<script>
  import 'invokers-polyfill';
  import 'dialog-closedby-polyfill';

  // ダイアログ領域外(::backdrop)押下で閉じる。closedby/polyfill に依存しない保険
  class NavDialog extends HTMLElement {
    connectedCallback() {
      this.addEventListener('click', this.#onClick)
    }
    disconnectedCallback() {
      this.removeEventListener('click', this.#onClick)
    }
    #onClick = (e: Event) => {
      const dialog = e.target
      if (!(dialog instanceof HTMLDialogElement) || !dialog.open) return
      const { clientX: x, clientY: y } = e as MouseEvent
      const r = dialog.getBoundingClientRect()
      if (x < r.left || x > r.right || y < r.top || y > r.bottom) dialog.close()
    }
  }
  customElements.define('nav-dialog', NavDialog)
</script>
