---
import { ClientRouter } from 'astro:transitions'
import Analytics from '@vercel/analytics/astro'
import GlobalHeader from '../components/common/GlobalHeader.astro'
import GlobalFooter from '../components/common/GlobalFooter.astro'
import '../styles/global.css'
import ToTopScroll from '../components/common/ToTopScroll.astro'
import HeadMeta from '../components/common/HeadMeta.astro'

interface Props {
	title?: string
	description?: string
	image?: string
	noindex?: boolean
	type?: 'website' | 'article'
}
---

<!doctype html>
<html lang="ja">
	<head>
		<HeadMeta {...Astro.props} />
    <slot name="head" />
    <Analytics />
    <ClientRouter />
	</head>
	<body>
    <GlobalHeader transition: persist />
	<main>
    <slot />
  </main>
    <ToTopScroll />
    <GlobalFooter transition: persist />
	</body>
</html>
