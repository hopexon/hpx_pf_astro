---
import { ClientRouter } from "astro:transitions"
import GlobalHeader from "../components/common/GlobalHeader.astro"
import GlobalFooter from "../components/common/GlobalFooter.astro"
import ToTopBtn from "../components/common/ToTopBtn.tsx"
import "../styles/global.css"
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
    <title>Astro Basics</title>
    <ClientRouter />
    <script
      type="module"
      src="https://unpkg.com/invokers-polyfill@latest/invoker.min.js"></script>
    <script
      type="module"
      src="https://cdn.jsdelivr.net/npm/dialog-closedby-polyfill@latest/index.min.js"
    ></script>
  </head>
  <body>
    <GlobalHeader transition: persist />
    <main>
      <slot />
      <ToTopBtn client:load />
    </main>
    <GlobalFooter transition: persist />
  </body>
</html>
