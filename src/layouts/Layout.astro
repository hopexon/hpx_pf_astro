---
import { ClientRouter } from 'astro:transitions'
import GlobalHeader from '../components/common/GlobalHeader.astro'
import GlobalFooter from '../components/common/GlobalFooter.astro'
import '../styles/global.css'
import ToTopScroll from '../components/common/ToTopScroll.astro'

interface Props {
	title?: string
	description?: string
}

const { title = 'Astro Basics', description } = Astro.props
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex" />
    <slot name="head" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
    <ClientRouter />
	</head>
	<body>
    <GlobalHeader transition: persist />
	<main>
    <slot />
  </main>
    <ToTopScroll />
    <GlobalFooter transition: persist />
	</body>
</html>