---
import { ClientRouter } from "astro:transitions";
import Analytics from '@vercel/analytics/astro'
import HeadMeta from "../components/common/HeadMeta.astro";
import GlobalHeader from "../components/common/GlobalHeader.astro";
import { Breadcrumbs } from "astro-breadcrumbs";
import CustomBreadCrumb from "../components/common/CustomBreadCrumb.astro";
import GlobalFooter from "../components/common/GlobalFooter.astro";
import ToTopBtn from "../components/common/ToTopBtn";
import { mtgSets } from "../pages/collections/mtg/sets/data";
import "../styles/global.css";
import "astro-breadcrumbs/breadcrumbs.css";

const { card } = Astro.props;

const cardSet = mtgSets.find((set) => set.name === card?.set);

// OGP 画像はカード画像(imgCard)。imgFull(イラスト)は無いカードがあるので使わない
const cardImage = card?.imgCard ? `/collections/mtg/${card.imgCard}` : undefined;

const customCrumbs = [
  // { label: "collections", href: "/collections/" },
  { label: "MTG", href: "/collections/mtg/" },
  { label: "Sets", href: "/collections/mtg/sets/" },
  { label: cardSet ? cardSet.name : "Unknown Set", href: cardSet ? `/collections/mtg/sets/${cardSet.slug}/` : undefined },
  // { label: card?.name ?? "Unknown Card" }
];
---

<!doctype html>
<html lang="ja">
  <head>
    <HeadMeta
      title=`${card?.name} | MTG Collection`
      description={card ? `${card.name} / ${card.set}` : undefined}
      image={cardImage}
    />
    <slot name="head" />
    <Analytics />
    <ClientRouter />
    <script>
      import 'invokers-polyfill';
      import 'dialog-closedby-polyfill';
    </script>
  </head>
  <body>
    <GlobalHeader transition: persist />
    <CustomBreadCrumb crumbs={customCrumbs} />
    <!-- <slot name="breadcrumb">
      <Breadcrumbs
        linkTextFormat="lower"
        ariaLabel="Breadcrumbs"
        truncated="true"
      ></Breadcrumbs>
    </slot> -->
    <!-- <Breadcrumbs
      linkTextFormat="lower"
      ariaLabel="Breadcrumbs"
      truncated="true"
    >
      <svg
        slot="index"
        aria-label="Home Page"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z">
        </path><polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      <svg
        slot="separator"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </Breadcrumbs> -->
    <main>
      <slot />
      <ToTopBtn client:load />
    </main>
    <GlobalFooter transition: persist />
  </body>
</html>
