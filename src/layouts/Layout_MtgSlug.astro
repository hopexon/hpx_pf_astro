---
import { ClientRouter } from "astro:transitions";
import GlobalHeader from "../components/common/GlobalHeader.astro";
import { Breadcrumbs } from "astro-breadcrumbs";
import CustomBreadCrumb from "../components/common/CustomBreadCrumb.astro";
import GlobalFooter from "../components/common/GlobalFooter.astro";
import ToTopBtn from "../components/common/ToTopBtn.tsx";
import { mtgSets } from "../pages/collections/mtg/sets/data";
import "../styles/global.css";
import "astro-breadcrumbs/breadcrumbs.css";

const { card } = Astro.props;

const cardSet = mtgSets.find((set) => set.name === card?.set);

const customCrumbs = [
  { label: "collections", href: "/collections/" },
  { label: "mtg", href: "/collections/mtg/" },
  { label: "sets", href: "/collections/mtg/sets/" },
  { label: cardSet ? cardSet.name : "Unknown Set", href: cardSet ? `/collections/mtg/sets/${cardSet.slug}/` : undefined },
  // { label: card?.name ?? "Unknown Card" }
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
    <title>Astro Basics</title>
    <ClientRouter />
    <script
      type="module"
      src="https://unpkg.com/invokers-polyfill@latest/invoker.min.js"></script>
    <script
      type="module"
      src="https://cdn.jsdelivr.net/npm/dialog-closedby-polyfill@latest/index.min.js"
    ></script>
  </head>
  <body>
    <GlobalHeader transition: persist />
    <CustomBreadCrumb crumbs={customCrumbs} />
    <!-- <slot name="breadcrumb">
      <Breadcrumbs
        linkTextFormat="lower"
        ariaLabel="Breadcrumbs"
        truncated="true"
      ></Breadcrumbs>
    </slot> -->
