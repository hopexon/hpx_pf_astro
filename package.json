{
  "name": "@example/basics",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:bg": "astro dev --background",
    "dev:lan": "astro dev --host",
    "build": "node scripts/build-cloudflare.mjs",
    "build:staging": "CLOUDFLARE_ENV=staging node scripts/build-cloudflare.mjs",
    "typecheck": "astro check",
    "preview": "pnpm build && astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:staging": "pnpm build:staging && wrangler deploy",
    "audit": "pnpm audit",
    "astro": "astro",
    "mtg:thumbs": "node scripts/generate-mtg-thumbs.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.7",
    "@astrojs/mdx": "^8.1.4",
    "@astrojs/react": "^6.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.10",
    "dialog-closedby-polyfill": "1.3.0",
    "focus-trap": "^8.2.4",
    "invokers-polyfill": "1.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.38.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "astro-breadcrumbs": "^3.4.2",
    "astro-expressive-code": "0.44.3",
    "sharp": "^0.35.5",
    "wrangler": "^4.160.0"
  }
}
